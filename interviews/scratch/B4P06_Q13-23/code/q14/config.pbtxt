name: "iris_onnx"
backend: "onnxruntime"
max_batch_size: 8
input [
  { name: "X", data_type: TYPE_FP32, dims: [ 4 ] }
]
output [
  { name: "label", data_type: TYPE_INT64, dims: [ 1 ], reshape: { shape: [ ] } },
  { name: "probabilities", data_type: TYPE_FP32, dims: [ 3 ] }
]
instance_group [
  { count: 1, kind: KIND_CPU }
]
