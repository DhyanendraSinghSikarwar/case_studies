## 5. Data Quality Checks

#%% code
dup = int(offers_raw.duplicated(["comp_id", "seller_id"]).sum()); o = offers_raw.drop_duplicates(["comp_id", "seller_id"]).copy()
o["comp_med"] = o.groupby("comp_id").price_inr.transform("median"); slip = o.price_inr / o.comp_med > 4
ev_n = survey.groupby(["arm", "participant_id", "task_comp_id"]).chosen.sum()
sd = sellers.copy(); recomputed = (sd.reviews_12m - sd.low_rated_12m) / (sd.reviews_12m - sd.struck_low_12m) * 100
checks = {"duplicate offer rows": dup, "price decimal slips (> 4x competition median)": int(slip.sum()), "missing shipping fee": int(o.shipping_inr.isna().sum()),
          "competitions without exactly one Buy Box winner": int((o.groupby("comp_id").is_buy_box.sum() != 1).sum()),
          "survey evaluations without exactly one vote": int((ev_n != 1).sum()), "sellers with reported feedback not matching counts (> 0.06 pt)": int(((recomputed - sd.pos_feedback_reported).abs() > 0.06).sum()),
          "sellers with struck > low-rated reviews": int((sd.struck_low_12m > sd.low_rated_12m).sum())}
print(pd.Series(checks, name="rows").to_string())
o.loc[slip, "price_inr"] = o.loc[slip, "price_inr"] / 10
fba_mean = o[(o.fulfilled_by_marketplace == 0) & o.shipping_inr.notna()].shipping_inr.mean()
o["shipping_inr"] = o.shipping_inr.fillna(pd.Series(np.where(o.fulfilled_by_marketplace == 1, 0.0, round(fba_mean, 1)), index=o.index))
o = o.drop(columns="comp_med").merge(sellers[["seller_id", "seller_type", "n_ratings", "pos_feedback_reported", "avg_rating_reported", "pos_feedback_rectified", "late_ship_rate", "defect_rate", "_true_pos_rate"]], on="seller_id")
o["total"] = o.price_inr + o.shipping_inr; o["min_total"] = o.groupby("comp_id").total.transform("min"); o["gap_pct"] = (o.total / o.min_total - 1) * 100; o["is_min"] = (o.gap_pct <= 1e-9).astype(int)
o["fast"] = (o.delivery_days <= 2).astype(int); o["log_n"] = np.log10(o.n_ratings); o["related"] = (o.seller_type == "related").astype(int); o = o.sort_values(["comp_id", "seller_id"]).reset_index(drop=True)
print(f"\nClean: {len(o):,} offers | {o.comp_id.nunique():,} competitions | {o.seller_id.nunique():,} sellers appear | mean offers per competition {o.groupby('comp_id').size().mean():.1f} | decimal slips divided by 10; missing FBM shipping set to the FBM mean (₹{fba_mean:.0f})")

