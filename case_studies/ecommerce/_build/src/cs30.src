### 7.5 Metric integrity: strike-through of bad reviews

**(a) Why?** If low-rated reviews of some sellers are struck through, their **displayed** feedback is inflated against the **rectified** figure computed from all reviews. We test (H4) whether the struck share differs between marketplace-fulfilled (related and FBA) and merchant-fulfilled sellers (two-proportion test on pooled counts, with a Wilson CI), measure the gap between reported and rectified feedback by seller type (**Wilcoxon signed-rank**, Holm), and check whether the metric still **ranks** sellers the same way (Spearman) and whether Buy Box winners look better on the reported metric than on the rectified one.

**(b) Assumptions:** reviews are independent counts per seller; only sellers with at least 100 reviews in 12 months are used for ranks (stable percentages).

#### Code

#%% code
sl = sellers.copy(); sl["fulfilled"] = np.where(sl.seller_type == "FBM", "merchant-fulfilled (FBM)", "marketplace-fulfilled (related + FBA)")
g = sl.groupby("fulfilled")[["low_rated_12m", "struck_low_12m"]].sum(); g["struck share"] = g.struck_low_12m / g.low_rated_12m
ff = sl[sl.fulfilled.str.startswith("marketplace")]; fm = sl[~sl.fulfilled.str.startswith("marketplace")]
cnt = np.array([ff.struck_low_12m.sum(), fm.struck_low_12m.sum()]); nob = np.array([ff.low_rated_12m.sum(), fm.low_rated_12m.sum()]); zz, pz = proportions_ztest(cnt, nob)
lo_f, hi_f = proportion_confint(cnt[0], nob[0], method="wilson")
print(f"Marketplace-fulfilled sellers: {cnt[0]:,} of {nob[0]:,} low-rated reviews struck = {cnt[0] / nob[0]:.2%} (Wilson CI {lo_f:.2%} to {hi_f:.2%}); documented 74.13% (97,603 of 131,664). Merchant-fulfilled: {cnt[1] / nob[1]:.2%}. z = {zz:.0f}, p = {pz:.2g}")
sl["gap_pts"] = sl.pos_feedback_reported - sl.pos_feedback_rectified; rows = []
for t_ in T3:
    x = sl[sl.seller_type == t_]; w_ = stats.wilcoxon(x.pos_feedback_reported, x.pos_feedback_rectified) if len(x) > 5 else None
    rows.append((t_, len(x), x.pos_feedback_reported.mean(), x.pos_feedback_rectified.mean(), x.gap_pts.mean(), x.gap_pts.median(), np.nan if w_ is None else w_.pvalue))
gp = pd.DataFrame(rows, columns=["seller type", "sellers", "mean reported %", "mean rectified %", "mean gap (pts)", "median gap (pts)", "Wilcoxon p"]).set_index("seller type")
gp["p_holm"] = np.nan; ok_ = gp["Wilcoxon p"].notna(); gp.loc[ok_, "p_holm"] = multipletests(gp.loc[ok_, "Wilcoxon p"], method="holm")[1]
big = sl[sl.reviews_12m >= 100]; rho_f = stats.spearmanr(big[big.seller_type != "FBM"].pos_feedback_reported, big[big.seller_type != "FBM"].pos_feedback_rectified)[0]; rho_m = stats.spearmanr(big[big.seller_type == "FBM"].pos_feedback_reported, big[big.seller_type == "FBM"].pos_feedback_rectified)[0]
q_rep = big.pos_feedback_reported.quantile(0.9); q_rec = big.pos_feedback_rectified.quantile(0.9); top_rep = big[big.pos_feedback_reported >= q_rep]; drop = (top_rep.pos_feedback_rectified < q_rec).mean()
w_ = win.copy(); o["rk_rep"] = o.groupby("comp_id").pos_feedback_reported.rank(ascending=False, method="min"); o["rk_rec"] = o.groupby("comp_id").pos_feedback_rectified.rank(ascending=False, method="min")
wr = o[o.is_buy_box == 1]; best_rep = (wr.rk_rep == 1).mean(); best_rec = (wr.rk_rec == 1).mean()
print(f"Related sellers: seller 0 reports {sl.pos_feedback_reported[0]:.1f}% positive, rectified {sl.pos_feedback_rectified[0]:.1f}% (documented Appario example: 87% to 61%); seller 1: {sl.pos_feedback_reported[1]:.1f}% to {sl.pos_feedback_rectified[1]:.1f}%")
print(f"Rank agreement reported vs rectified (sellers with >= 100 reviews): Spearman {rho_f:.2f} for marketplace-fulfilled, {rho_m:.2f} for merchant-fulfilled; of the top-10% sellers by reported feedback, {drop:.1%} are below the top-10% cut on rectified feedback")
print(f"Buy Box winner has the best positive feedback in its competition in {best_rep:.1%} of competitions on the reported metric, but only {best_rec:.1%} on the rectified metric")
fig, axes = plt.subplots(1, 2, figsize=(13, 4.4)); smp = big.sample(700, random_state=SEED)
for t_ in T3: x = smp[smp.seller_type == t_]; axes[0].scatter(x.pos_feedback_rectified, x.pos_feedback_reported, s=14, alpha=0.5, color=cols3[t_], label=t_)
axes[0].scatter(sl.pos_feedback_rectified[:2], sl.pos_feedback_reported[:2], s=90, marker="*", color="k", label="related (2)"); axes[0].plot([40, 100], [40, 100], "k--", lw=1); axes[0].set_xlabel("Rectified positive feedback (%)"); axes[0].set_ylabel("Reported positive feedback (%)"); axes[0].set_title("Reported metric sits above rectified for fulfilled sellers"); axes[0].legend(fontsize=8)
shr = sl.groupby("seller_type")[["struck_low_12m", "low_rated_12m"]].sum().reindex(T3); sv_ = (shr.struck_low_12m / shr.low_rated_12m * 100)
axes[1].bar(T3, sv_.values, color=[cols3[t_] for t_ in T3]); axes[1].set_xlabel("Seller type"); axes[1].set_ylabel("Low-rated reviews struck through (%)"); axes[1].set_title("Who gets its bad reviews struck through")
plt.tight_layout(); plt.show(); gp.round(4)

