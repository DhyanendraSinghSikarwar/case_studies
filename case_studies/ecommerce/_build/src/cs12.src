level = np.r_[0, np.ones(len(REGS)), 2 * np.ones(len(FCL)), 3 * np.ones(NB)].astype(int); LV = ["Total", "Region", "FC", "FC × category"]
names = ["Total"] + REGS + FCL + [f"{f} | {c}" for f, c in zip(fcs, cats)]
