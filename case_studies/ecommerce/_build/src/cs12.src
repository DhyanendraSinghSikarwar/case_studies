#%% code
allm = pd.concat([cov_.add_prefix("80% coverage: "), wape.add_prefix("WAPE: "), esdf], axis=1)
print("Nominal 80% interval coverage should be 0.80; WAPE = sum|y - mean forecast| / sum y; Energy Score lower is better")
