#%% code
regs = [k[0] for k in Yb.columns]; fcs = [k[1] for k in Yb.columns]; cats = [k[2] for k in Yb.columns]
REGS = list(dict.fromkeys(regs)); FCL = list(dict.fromkeys(fcs)); CATL = list(dict.fromkeys(cats))
