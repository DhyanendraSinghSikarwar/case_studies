# outcomes: pre window months 6-11, post window months 12-17
F["ypre"], F["ypost"] = O.loc[:, 6:11].mean(1), O.loc[:, 12:17].mean(1); F["dy"] = F.ypost - F.ypre
F["gpre"], F["gpost"] = G.loc[:, 6:11].mean(1), G.loc[:, 12:17].mean(1); F["dg"] = F.gpost - F.gpre
