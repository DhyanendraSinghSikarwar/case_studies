    "market: duplicate minute rows": int(m0_.duplicated("minute").sum()), "market: minutes with missing requests": int(m0_.drop_duplicates("minute").requests.isna().sum()), "market: supply spikes (> 1.8× rolling median)": int(sp_chk.sum()),
}
